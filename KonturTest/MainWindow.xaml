<Window x:Class="KonturTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:KonturTest.Views"
        xmlns:vm="clr-namespace:KonturTest.ViewModels"
        mc:Ignorable="d"
        Title="KonturTest"
        Height="360" Width="680"
        MinHeight="260" MinWidth="480"
        WindowStartupLocation="CenterScreen">

    <TabControl>
        <TabItem Header="Задача 1: Пакеты → CSV">
            <views:Task1View DataContext="{Binding Task1}"/>
        </TabItem>
        <TabItem Header="Задача 2: Битовые поля → CSV">
            <views:Task2View DataContext="{Binding Task2}"/>
        </TabItem>
    </TabControl>

</Window>
